@model BrightSmileDentalClinic.ViewModels.AppointmentRequestViewModel

@{
    ViewData["Title"] = "Book an Appointment";
}

<section class="page-hero" aria-labelledby="booking-heading">
    <div class="container py-5">
        <span class="eyebrow">Request your visit</span>
        <h1 id="booking-heading" class="display-5 fw-bold mt-2">Book an Appointment</h1>
        <p class="lead mb-0">Tell us what you need and choose your preferred dentist, service, date, and time.</p>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <form asp-action="Create" method="post" class="booking-form card border-0 shadow-sm" novalidate>
                <div class="card-body p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <fieldset class="mb-5">
                        <legend class="h3 mb-1">Patient information</legend>
                        <p class="text-secondary mb-4">Fields marked with an asterisk are required.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label required-label"></label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label required-label"></label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label required-label"></label>
                                <input asp-for="DateOfBirth" class="form-control" max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label required-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label required-label"></label>
                                <input asp-for="Email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label required-label"></label>
                                <input asp-for="Address" class="form-control" autocomplete="street-address" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset>
                        <legend class="h3 mb-1">Appointment preferences</legend>
                        <p class="text-secondary mb-4">Your request will remain pending until clinic staff approve it.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DentistId" class="form-label required-label"></label>
                                <select asp-for="DentistId" asp-items="Model.Dentists" class="form-select">
                                    <option value="">Choose a dentist</option>
                                </select>
                                <span asp-validation-for="DentistId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ServiceId" class="form-label required-label"></label>
                                <select asp-for="ServiceId" asp-items="Model.Services" class="form-select">
                                    <option value="">Choose a service</option>
                                </select>
                                <span asp-validation-for="ServiceId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AppointmentDate" class="form-label required-label"></label>
                                <input asp-for="AppointmentDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AppointmentTime" class="form-label required-label"></label>
                                <input asp-for="AppointmentTime" class="form-control" step="900" />
                                <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="ReasonForVisit" class="form-label required-label"></label>
                                <textarea asp-for="ReasonForVisit" class="form-control" rows="4"
                                          placeholder="Briefly describe how we can help."></textarea>
                                <span asp-validation-for="ReasonForVisit" class="text-danger"></span>
                            </div>
                        </div>
                    </fieldset>

                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mt-4">
                        <button type="submit" class="btn btn-clinic btn-lg">Submit appointment request</button>
                        <span class="small text-secondary">Submitting this form does not confirm the appointment.</span>
                    </div>
                </div>
            </form>
        </div>
        <aside class="col-lg-4" aria-label="Booking information">
            <div class="booking-help card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">What happens next?</h2>
                    <ol class="ps-3 mb-0 text-secondary">
                        <li class="mb-3">We receive your appointment request.</li>
                        <li class="mb-3">Clinic staff review the selected time.</li>
                        <li>We contact you when the appointment is approved or if another time is needed.</li>
                    </ol>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
