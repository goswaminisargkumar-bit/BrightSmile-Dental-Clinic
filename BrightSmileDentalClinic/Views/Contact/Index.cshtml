@model BrightSmileDentalClinic.ViewModels.ContactFormViewModel

@{
    ViewData["Title"] = "Contact Us";
}

<section class="page-hero" aria-labelledby="contact-heading">
    <div class="container py-5">
        <span class="eyebrow">We are here to help</span>
        <h1 id="contact-heading" class="display-5 fw-bold mt-2">Contact BrightSmile</h1>
        <p class="lead mb-0">Ask a question, request more information, or speak with our friendly clinic team.</p>
    </div>
</section>

<section class="container py-5">
    @if (TempData["ContactSuccess"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <form asp-action="Index" method="post" class="contact-form card border-0 shadow-sm" novalidate>
                <div class="card-body p-4 p-md-5">
                    <h2 class="h3 mb-1">Send us a message</h2>
                    <p class="text-secondary mb-4">Fields marked with an asterisk are required.</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label required-label"></label>
                            <input asp-for="Name" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label required-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Subject" class="form-label required-label"></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label required-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="6"
                                      placeholder="How can our clinic team help?"></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-clinic btn-lg mt-4">Send message</button>
                </div>
            </form>
        </div>

        <aside class="col-lg-5" aria-label="Clinic contact details">
            <div class="contact-details card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4">Clinic information</h2>
                    <address class="mb-0 text-secondary">
                        <strong class="text-body">BrightSmile Dental Clinic</strong><br />
                        100 Smile Avenue<br />
                        Kitchener, Ontario N2G 1A1
                    </address>
                    <hr />
                    <dl class="contact-list mb-0">
                        <div><dt>Phone</dt><dd><a href="tel:+15195550100">519-555-0100</a></dd></div>
                        <div><dt>Email</dt><dd><a href="mailto:info@brightsmile.example">info@brightsmile.example</a></dd></div>
                    </dl>
                </div>
            </div>

            <div class="contact-details card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Office hours</h2>
                    <dl class="hours-list mb-0">
                        <div><dt>Monday - Friday</dt><dd>9:00 AM - 6:00 PM</dd></div>
                        <div><dt>Saturday</dt><dd>10:00 AM - 4:00 PM</dd></div>
                        <div><dt>Sunday</dt><dd>Closed</dd></div>
                    </dl>
                    <p class="small text-secondary mt-3 mb-0">For a dental emergency, please call the clinic directly.</p>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
