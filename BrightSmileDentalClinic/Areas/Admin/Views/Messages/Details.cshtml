@model ContactMessage
@{ ViewData["Title"] = "Message Details"; }
<div class="container py-4 py-lg-5"><div class="admin-detail-card"><span class="admin-eyebrow">Message #@Model.ContactMessageId</span><h1 class="h2 mt-1">@Model.Subject</h1><dl class="admin-detail-grid"><div><dt>From</dt><dd>@Model.Name</dd></div><div><dt>Submitted</dt><dd>@Model.SubmittedDate.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")</dd></div><div><dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd></div><div><dt>Phone</dt><dd>@(Model.PhoneNumber ?? "Not provided")</dd></div><div class="detail-wide"><dt>Message</dt><dd class="message-body">@Model.Message</dd></div></dl><div class="admin-form-actions"><a href="mailto:@Model.Email" class="btn btn-admin">Reply by email</a><a asp-action="Delete" asp-route-id="@Model.ContactMessageId" class="btn btn-outline-danger">Delete</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div></div>
