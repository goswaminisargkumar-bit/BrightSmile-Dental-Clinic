@model IReadOnlyList<ContactMessage>
@{ ViewData["Title"] = "Contact Messages"; }
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5"><div class="admin-page-heading"><div><span class="admin-eyebrow">Clinic inbox</span><h1 class="display-6 fw-bold mt-1">Messages</h1></div></div><partial name="_AdminAlerts" /><div class="admin-table-card">@if(Model.Count==0){<div class="admin-empty"><h2 class="h4">No contact messages</h2><p>Messages from the public Contact page will appear here.</p></div>}else{<div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>From</th><th>Subject</th><th>Submitted</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var message in Model){<tr><td><strong>@message.Name</strong><small>@message.Email</small></td><td>@message.Subject</td><td>@message.SubmittedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@message.ContactMessageId" class="btn btn-sm btn-outline-primary">View</a> <a asp-action="Delete" asp-route-id="@message.ContactMessageId" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>}</div></div>
