@model Appointment
@{ ViewData["Title"] = "Appointment Details"; }
<div class="container py-4 py-lg-5"><div class="admin-detail-card"><div class="admin-detail-heading"><div><span class="admin-eyebrow">Request #@Model.AppointmentId</span><h1 class="h2 mt-1">Appointment Details</h1></div><span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></div><partial name="_AdminAlerts" /><dl class="admin-detail-grid"><div><dt>Patient</dt><dd><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId">@Model.Patient?.FullName</a></dd></div><div><dt>Email</dt><dd>@Model.Patient?.Email</dd></div><div><dt>Phone</dt><dd>@Model.Patient?.PhoneNumber</dd></div><div><dt>Dentist</dt><dd>Dr. @Model.Dentist?.FullName</dd></div><div><dt>Service</dt><dd>@Model.Service?.ServiceName</dd></div><div><dt>Preferred date</dt><dd>@Model.AppointmentDate.ToString("dddd, MMMM d, yyyy")</dd></div><div><dt>Preferred time</dt><dd>@DateTime.Today.Add(Model.AppointmentTime).ToString("h:mm tt")</dd></div><div><dt>Submitted</dt><dd>@Model.CreatedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd></div><div class="detail-wide"><dt>Reason for visit</dt><dd>@Model.ReasonForVisit</dd></div></dl>@if(Model.Status==AppointmentStatus.Pending){<div class="admin-form-actions"><form asp-action="Approve" asp-route-id="@Model.AppointmentId" method="post"><button class="btn btn-success" type="submit">Approve request</button></form><form asp-action="Cancel" asp-route-id="@Model.AppointmentId" method="post"><button class="btn btn-danger" type="submit">Cancel request</button></form><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>}else{<a asp-action="Index" class="btn btn-outline-secondary mt-4">Back to appointments</a>}</div></div>
