@model Patient
@{ ViewData["Title"] = "Patient Details"; }
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5"><div class="admin-detail-card mb-4"><span class="admin-eyebrow">Patient #@Model.PatientId</span><h1 class="h2 mt-1">@Model.FullName</h1><dl class="admin-detail-grid"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Phone</dt><dd>@Model.PhoneNumber</dd></div><div><dt>Date of birth</dt><dd>@Model.DateOfBirth.ToString("MMMM d, yyyy")</dd></div><div><dt>Address</dt><dd>@Model.Address</dd></div></dl><a asp-action="Index" class="btn btn-outline-secondary">Back to patients</a></div><div class="admin-table-card"><div class="admin-panel-header"><h2 class="h4 mb-0">Appointment history</h2></div>@if(Model.Appointments.Count==0){<div class="admin-empty"><p>No appointments found.</p></div>}else{<div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>Date</th><th>Dentist</th><th>Service</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model.Appointments){<tr><td>@item.AppointmentDate.ToString("MMM d, yyyy")<small>@DateTime.Today.Add(item.AppointmentTime).ToString("h:mm tt")</small></td><td>Dr. @item.Dentist?.FullName</td><td>@item.Service?.ServiceName</td><td><span class="status-badge status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span></td><td class="text-end"><a asp-controller="Appointments" asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-primary">View</a></td></tr>}</tbody></table></div>}</div></div>
