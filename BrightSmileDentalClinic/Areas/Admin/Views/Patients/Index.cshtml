@model IReadOnlyList<Patient>
@{ ViewData["Title"] = "Patient Records"; }
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5"><div class="admin-page-heading"><div><span class="admin-eyebrow">Clinic records</span><h1 class="display-6 fw-bold mt-1">Patients</h1></div><form method="get" class="admin-search"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name, email, or phone"/><button class="btn btn-admin">Search</button></form></div><div class="admin-table-card">@if(Model.Count==0){<div class="admin-empty"><h2 class="h4">No patients found</h2><p>Patient records are created through appointment requests.</p></div>}else{<div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>Patient</th><th>Contact</th><th>Date of birth</th><th>Appointments</th><th class="text-end">Action</th></tr></thead><tbody>@foreach(var patient in Model){<tr><td><strong>@patient.FullName</strong><small>@patient.Address</small></td><td>@patient.Email<small>@patient.PhoneNumber</small></td><td>@patient.DateOfBirth.ToString("MMM d, yyyy")</td><td>@patient.Appointments.Count</td><td class="text-end"><a asp-action="Details" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-primary">View</a></td></tr>}</tbody></table></div>}</div></div>
