@model IReadOnlyList<Dentist>

@{ ViewData["Title"] = "Manage Dentists"; }

<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="admin-page-heading">
        <div><span class="admin-eyebrow">Clinic team</span><h1 class="display-6 fw-bold mt-1">Manage Dentists</h1></div>
        <a asp-action="Create" class="btn btn-admin">Add dentist</a>
    </div>
    <partial name="_AdminAlerts" />

    <div class="admin-table-card">
        @if (Model.Count == 0)
        {
            <div class="admin-empty"><h2 class="h4">No dentists found</h2><p>Add the first dentist profile.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead><tr><th>Dentist</th><th>Specialization</th><th>Experience</th><th>Appointments</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var dentist in Model)
                    {
                        <tr>
                            <td><strong>Dr. @dentist.FullName</strong><small>@dentist.Email</small></td>
                            <td>@dentist.Specialization</td>
                            <td>@dentist.YearsOfExperience years</td>
                            <td>@dentist.Appointments.Count</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@dentist.DentistId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@dentist.DentistId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
