@model Dentist
@{ ViewData["Title"] = "Delete Dentist"; }
<div class="container py-4 py-lg-5"><div class="admin-delete-card"><span class="admin-eyebrow">Confirm deletion</span><h1 class="h2 mt-1">Delete Dr. @Model.FullName?</h1><p>This removes the dentist from public listings and the Admin portal.</p>@if (Model.Appointments.Count > 0){<div class="alert alert-warning">This dentist has @Model.Appointments.Count appointment record(s) and cannot be deleted.</div>}<dl class="admin-summary"><div><dt>Specialization</dt><dd>@Model.Specialization</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Availability</dt><dd>@Model.Availability</dd></div></dl><form asp-action="Delete" asp-route-id="@Model.DentistId" method="post"><button type="submit" class="btn btn-danger" disabled="@(Model.Appointments.Count > 0)">Delete dentist</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div>
