@model IReadOnlyList<Service>

@{ ViewData["Title"] = "Manage Services"; }

<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="admin-page-heading"><div><span class="admin-eyebrow">Treatments</span><h1 class="display-6 fw-bold mt-1">Manage Services</h1></div><a asp-action="Create" class="btn btn-admin">Add service</a></div>
    <partial name="_AdminAlerts" />
    <div class="admin-table-card">
        @if (Model.Count == 0){<div class="admin-empty"><h2 class="h4">No services found</h2><p>Add the first dental service.</p></div>}
        else
        {
            <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>Service</th><th>Duration</th><th>Price</th><th>Status</th><th>Appointments</th><th class="text-end">Actions</th></tr></thead><tbody>
            @foreach (var service in Model)
            {
                <tr><td><strong>@service.ServiceName</strong><small>@service.Description</small></td><td>@service.DurationMinutes min</td><td>@service.Price.ToString("C")</td><td>@if(service.IsAvailable){<span class="badge text-bg-success">Available</span>}else{<span class="badge text-bg-secondary">Unavailable</span>}</td><td>@service.Appointments.Count</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>
            }
            </tbody></table></div>
        }
    </div>
</div>
