@model Service
@{ ViewData["Title"] = "Delete Service"; }
<div class="container py-4 py-lg-5"><div class="admin-delete-card"><span class="admin-eyebrow">Confirm deletion</span><h1 class="h2 mt-1">Delete @Model.ServiceName?</h1><p>This removes the service from public listings and appointment choices.</p>@if(Model.Appointments.Count > 0){<div class="alert alert-warning">This service has @Model.Appointments.Count appointment record(s) and cannot be deleted.</div>}<dl class="admin-summary"><div><dt>Duration</dt><dd>@Model.DurationMinutes minutes</dd></div><div><dt>Price</dt><dd>@Model.Price.ToString("C")</dd></div><div><dt>Status</dt><dd>@(Model.IsAvailable ? "Available" : "Unavailable")</dd></div></dl><form asp-action="Delete" asp-route-id="@Model.ServiceId" method="post"><button type="submit" class="btn btn-danger" disabled="@(Model.Appointments.Count > 0)">Delete service</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div>
